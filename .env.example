# LXL·QuantAxis Environment Variables
# Copy to .env and fill in values

# Security (REQUIRED for production)
LXL_ENV=development
JWT_SECRET_KEY=
ADMIN_PASSWORD=

# Data directory
QUANT_DATA_DIR=~/lxl_quantaxis_data

# AI/LLM (optional)
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# Network
LXL_BIND_HOST=127.0.0.1
LXL_REGISTRATION_ENABLED=true

# Broker (paper only)
QUANT_BROKER=paper

