{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lxl-quantaxis.local/schemas/strategy-spec-v1.json",
  "title": "LXL QuantAxis StrategySpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["strategy_id", "version", "name", "description", "source", "data_requirements", "parameters", "rules"],
  "properties": {
    "strategy_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "source": {"enum": ["manual", "ai", "legacy"]},
    "data_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "default", "minimum", "maximum", "choices"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "type": {"enum": ["integer", "number", "boolean", "string"]},
          "default": {"type": ["string", "integer", "number", "boolean"]},
          "minimum": {"type": ["number", "null"]},
          "maximum": {"type": ["number", "null"]},
          "choices": {"type": "array"}
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "exit"],
      "properties": {
        "entry": {"type": "string"},
        "exit": {"type": "string"}
      }
    }
  }
}
